iption": "The authorized payload destination. Suppressed strictly on DENY."}, "reason": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Reason", "description": "Contextual diagnostic string regarding the verdict."}}, "type": "object", "required": ["result"], "title": "ScanVerifyResponse", "description": "The normalized verdict routing directive transmitted back to the scanner."}, "ScannerDeviceCreateRequest": {"properties": {"name": {"type": "string", "maxLength": 255, "minLength": 1, "title": "Name"}, "scopes": {"items": {"type": "string"}, "type": "array", "title": "Scopes", "default": ["scan:verify"]}}, "type": "object", "required": ["name"], "title": "ScannerDeviceCreateRequest", "description": "Scanner device creation request."}, "ScannerDeviceCreateResponse": {"properties": {"device_id": {"type": "string", "format": "uuid", "title": "Device Id"}, "api_key": {"type": "string", "title": "Api Key"}, "hmac_secret": {"type": "string", "title": "Hmac Secret"}, "name": {"type": "string", "title": "Name"}, "scopes": {"items": {"type": "string"}, "type": "array", "title": "Scopes"}}, "type": "object", "required": ["device_id", "api_key", "hmac_secret", "name", "scopes"], "title": "ScannerDeviceCreateResponse", "description": "Scanner device creation response (API key returned once)."}, "TokenCreateRequest": {"properties": {"payload_url": {"type": "string", "maxLength": 2048, "title": "Payload Url", "description": "The target URL or URI the QR code will direct to after verification."}, "expires_in_hours": {"anyOf": [{"type": "integer", "maximum": 8760.0, "minimum": 1.0}, {"type": "null"}], "title": "Expires In Hours", "description": "Optional expiration limit in hours from creation."}}, "type": "object", "required": ["payload_url"], "title": "TokenCreateRequest", "description": "Payload details for generating a new SVT."}, "TokenDetailsResponse": {"properties": {"id": {"type": "string", "format": "uuid", "title": "Id"}, "trace_id": {"type": "string", "title"