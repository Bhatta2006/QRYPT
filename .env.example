# =============================================================================
# SVT System — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# --- PostgreSQL / TimescaleDB ---
POSTGRES_USER=svt_admin
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=svt
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://svt_app:CHANGE_ME_app_password@postgres:5432/svt

# Application DB user (non-superuser)
SVT_APP_DB_USER=svt_app
SVT_APP_DB_PASSWORD=CHANGE_ME_app_password

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379/0

# --- JWT / Auth ---
JWT_SECRET_KEY=CHANGE_ME_minimum_64_chars_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Google Cloud KMS (for key encryption) ---
# Format: projects/{project}/locations/{location}/keyRings/{keyring}/cryptoKeys/{key}
KMS_KEY_NAME=projects/svt-project/locations/global/keyRings/svt-keyring/cryptoKeys/svt-issuer-keys
# Set to "local" for development (uses local file-based mock)
KMS_PROVIDER=local

# --- GeoIP ---
GEOIP_DB_PATH=/app/data/GeoLite2-City.mmdb

# --- Admin Webhook (Slack / PagerDuty) ---
ADMIN_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME

# --- Application ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
OTEL_SERVICE_NAME=svt-backend

# --- GCP (Production only) ---
GCP_PROJECT_ID=svt-project
GCP_REGION=us-central1

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
