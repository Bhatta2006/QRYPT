      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(scan_verify_duration_seconds_bucket[5m]))",
          "legendFormat": "P95"
        }
      ]
    },
    {
      "id": 4,
      "title": "P99 Latency",
      "type": "stat",
