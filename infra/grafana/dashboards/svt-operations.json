  "panels": [
    {
      "id": 1,
      "title": "Scan Rate",
      "type": "stat",
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "rate(svt_scans_total[5m])",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "P50 Latency",
      "type": "stat",
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(scan_verify_duration_seconds_bucket[5m]))",
          "legendFormat": "P50"
        }
      ]
    },
    {
      "id": 3,
      "title": "P95 Latency",
      "type": "stat",
      "datasource": "Prometheus",
