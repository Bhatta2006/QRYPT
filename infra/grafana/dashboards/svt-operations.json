        }
      ]
    },
    {
      "id": 5,
      "title": "Error Rate",
      "type": "gauge",
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 0.01}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 6},
      "targets": [
        {
          "expr": "rate(svt_scans_total{result=\"DENY\"}[5m]) / rate(svt_scans_total[5m])",
          "legendFormat": "Error Rate"
        }
      ]
    },
    {
      "id": 6,
      "title": "Anomaly Rate by Rule",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "targets": [
        {
          "expr": "rate(svt_anomalies_total[5m])",
          "legendFormat": "{{rule}}"
        }
